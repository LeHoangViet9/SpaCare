{
  "name": "spacare-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "db:staff-phone": "tsx --env-file=.env.local scripts/setup-staff-phone.ts",
    "push:setup": "node scripts/setup-push.mjs",
    "push:db": "tsx --env-file=.env.local scripts/setup-push-db.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "test:integration": "tsx --env-file=.env.test.local --test tests/integration.test.ts",
    "db:setup": "tsx --env-file=.env.local scripts/setup.ts",
    "db:demo": "tsx --env-file-if-exists=.env.demo.local scripts/seed-demo.ts",
    "dev:demo": "tsx --env-file-if-exists=.env.demo.local scripts/dev-demo.ts",
    "db:demo:check": "tsx --env-file-if-exists=.env.demo.local scripts/seed-demo.ts --check",
    "test:ui": "playwright test --config=playwright.config.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "mongoose": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
